[core]
  editor = {{ if .server }}vim{{ else }}nvim{{ end }}
{{- if not .server }}
  pager = delta
[interactive]
  diffFilter = delta --color-only
{{- end }}
[transfer]
  fsckobjects = true
[alias]
  gst = git
  st = status
  di = diff
  co = checkout
  sw = switch
  rs = restore
  ci = commit
  cp = cherry-pick
  br = branch
  sta = stash
  llog = log --date=local
  flog = log --pretty=fuller --decorate
  lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
  lol = log --graph --decorate --oneline
  lola = log --graph --decorate --oneline --all
  blog = "!git log \"$(git trunk)\"... --left-right"
  ds = diff --staged
  fixup = commit --fixup
  squash = commit --squash
  amendit = commit --amend --no-edit
  unstage = reset HEAD
  rum = "!git rebase \"$(git trunk)\""
  # origin's default branch: origin/HEAD if set (clones set it), else origin/main or origin/master
  trunk = "!f() { git symbolic-ref -q --short refs/remotes/origin/HEAD || { git rev-parse -q --verify origin/main >/dev/null && echo origin/main; } || echo origin/master; }; f"
  unpushed = log @{u}..
  unpulled = !git fetch && git log ..@{u}
  w = log --raw --no-merges
[format]
  pretty = format:"%h %C(yellow)%ci%Creset %Cgreen%an%Creset | %s"
[user]
	name = {{ .name }}
	email = {{ .email }}
[pull]
	rebase = true
[push]
  autoSetupRemote = true  # first push of a new branch sets its upstream
[fetch]
  prune = true            # forget remote branches that were deleted
[rebase]
  autoStash = true        # stash/unstash around rebase and pull
  autoSquash = true       # apply fixup!/squash! commits (see the fixup/squash aliases)
  updateRefs = true       # move stacked branches along with a rebase
[rerere]
  enabled = true          # reuse recorded conflict resolutions
[diff]
  algorithm = histogram
[merge]
  # zdiff3 needs git 2.35+; servers may have an older distro git
  conflictStyle = {{ if .server }}diff3{{ else }}zdiff3{{ end }}
[branch]
  sort = -committerdate   # git branch: most recent first
[tag]
  sort = version:refname  # v1.10 after v1.9
{{- if not .server }}
[delta]
  whitespace-error-style = 22 reverse
  side-by-side = true
{{- end }}
[init]
  defaultBranch = main
{{- if and (not .server) (eq .chezmoi.os "darwin") }}
[credential]
	helper =
	helper = /usr/local/share/gcm-core/git-credential-manager
{{- end }}
# Machine-specific settings that stay out of this repo, like credential blocks for
# private hosts. Git skips the include when the file doesn't exist.
[include]
	path = ~/.gitconfig.local
