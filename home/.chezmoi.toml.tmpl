{{- /* Asked once per machine, then stored in ~/.config/chezmoi/chezmoi.toml */ -}}
{{- $name := promptStringOnce . "name" "Git name" "Mik Freedman" -}}
{{- $email := promptStringOnce . "email" "Git email" "github@michael-freedman.com" -}}
{{- $server := promptBoolOnce . "server" "Server (Vim only, no Neovim/GUI apps)" false -}}
{{- /* Not prompted: edit ~/.config/chezmoi/chezmoi.toml by hand. Kept when chezmoi init re-runs. */ -}}
{{- $brewSkip := get . "brew_skip" | default list -}}

# Remember the checkout `chezmoi init --source <path>` was run from, so later commands use it
sourceDir = {{ .chezmoi.sourceDir | quote }}

[data]
  name = {{ $name | quote }}
  email = {{ $email | quote }}
  server = {{ $server }}
  # Homebrew formulae and casks this machine shouldn't install, e.g. because work
  # tooling manages them. Use the names from .chezmoidata/packages.yaml.
  brew_skip = {{ $brewSkip | toJson }}
