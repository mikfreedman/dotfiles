#!/usr/bin/env bash
# Bump every Vim plugin in home/.chezmoidata/vim_plugins.yaml to its upstream HEAD.
# Review with `git diff`, commit, then `chezmoi apply`.
set -euo pipefail
file="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/home/.chezmoidata/vim_plugins.yaml"
tmp="$(mktemp)"
while IFS= read -r line; do
  if [[ "$line" =~ repo:\ ([^,]+), ]]; then
    repo="${BASH_REMATCH[1]}"
    commit="$(git ls-remote "https://github.com/$repo" HEAD | cut -f1)"
    line="$(sed -E "s/commit: [0-9a-f]+/commit: $commit/" <<<"$line")"
  fi
  echo "$line"
done <"$file" >"$tmp"
mv "$tmp" "$file"
echo "Updated $file - review with git diff"
