#
# Executes commands at the start of an interactive session.
#

if [[ -f "$HOME/.iterm2/it2check" ]]; then
	$HOME/.iterm2/it2check
	if [ $? -eq 0 ]; then
		export TERM_PROGRAM='iTerm.app'
	fi
fi

# Source Prezto. It sets the Emacs keymap, up/down history-substring search, and
# the AUTO_CD/AUTO_PUSHD/MULTIOS/NO_CLOBBER/NO_FLOW_CONTROL/NO_HUP family of options.
if [[ -s "${ZDOTDIR:-$HOME}/.zprezto/init.zsh" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprezto/init.zsh"
fi

# OSX
alias fixow='/System/Library/Frameworks/CoreServices.framework/Versions/A/Frameworks/LaunchServices.framework/Versions/A/Support/lsregister -kill -r -domain local -domain user;killall Finder;echo "Open With has been rebuilt, Finder will relaunch"'
# tmux
alias tma='tmux attach -d -t'
alias tmn='tmux new -s $(basename $(pwd))'
alias tml='tmux list-sessions'

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"

#
# Options on top of Prezto's
#

setopt AUTO_NAME_DIRS     # Use named dirs (~foo) in prompts when possible
setopt GLOB_COMPLETE      # Complete globs as a menu instead of expanding them
setopt PUSHD_MINUS        # cd -1 is the most recent dir, not the oldest
setopt CLOBBER            # Let > overwrite existing files (Prezto turns this off)
setopt NO_CASE_GLOB       # Case-insensitive globbing
setopt NUMERIC_GLOB_SORT  # Sort file2 before file10
setopt RC_EXPAND_PARAM    # foo${arr}bar applies foo/bar to every element
setopt NO_EXTENDED_GLOB   # Treat #, ~ and ^ literally (Prezto turns this on)
setopt NO_NOMATCH         # Pass unmatched globs through unchanged
setopt RM_STAR_SILENT     # Don't ask before rm *

# Home/End in terminals that send these sequences
bindkey '\e[1~' beginning-of-line
bindkey '\e[4~' end-of-line

# F1 shows help for the command being typed
bindkey "\eOP" run-help

SPACESHIP_GIT_SYMBOL=""
SPACESHIP_GIT_BRANCH_PREFIX=""

SPACESHIP_PROMPT_ORDER=(
  time          # Time stampts section
  user          # Username section
  dir           # Current directory section
  host          # Hostname section
  git           # Git section (git_branch + git_status)
  exec_time     # Execution time
  line_sep      # Line break
  jobs          # Background jobs indicator
  exit_code     # Exit code section
  char          # Prompt character
)

SPACESHIP_DIR_TRUNC="0"
SPACESHIP_DIR_TRUNC_REPO="false"

test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion
eval "$(direnv hook zsh)"

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
[ -f ~/.fzfrc ] && source ~/.fzfrc

test -e /usr/share/doc/fzf/examples/key-bindings.zsh && source /usr/share/doc/fzf/examples/key-bindings.zsh
test -e /usr/share/doc/fzf/examples/completion.zsh && source /usr/share/doc/fzf/examples/completion.zsh

export GOPRIVATE=*.eng.vmware.com
alias cat='bat'

if [ -x fzf ]; then
  eval "$(fzf --zsh)"
fi

# Use Neovim as vim when it's installed (servers without it keep plain Vim).
# EDITOR/VISUAL are set in .zprofile.
if (( $+commands[nvim] )); then
  alias vim=nvim vi=nvim vimdiff='nvim -d'
fi

# Use Neovide as the GUI vim
if (( $+commands[neovide] )); then
  alias mvim=neovide
fi

if [ -f ~/.zshrc.local ]; then
  source ~/.zshrc.local
fi
