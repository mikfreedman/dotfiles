{{ if and (eq .chezmoi.os "linux") (not .server) -}}
#!/usr/bin/env bash
set -euo pipefail
log() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }

# Distro Neovim packages lag behind; nvim-treesitter needs 0.12+.
# Pinned versions come from .chezmoidata/packages.yaml; bumping one re-runs this script.
NVIM_VERSION={{ .versions.nvim }}
TREE_SITTER_VERSION={{ .versions.tree_sitter }}
NERD_FONTS_VERSION={{ .versions.nerd_fonts }}
LOCAL_BIN="$HOME/.local/bin"
mkdir -p "$LOCAL_BIN"

case "$(uname -m)" in
  x86_64) nvim_arch=x86_64; ts_arch=x64 ;;
  aarch64|arm64) nvim_arch=arm64; ts_arch=arm64 ;;
  *) echo "Unsupported architecture: $(uname -m)" >&2; exit 1 ;;
esac

if [[ "$("$LOCAL_BIN/nvim" --version 2>/dev/null | head -1)" != "NVIM $NVIM_VERSION" ]]; then
  log "Installing Neovim $NVIM_VERSION to ~/.local/opt"
  mkdir -p "$HOME/.local/opt"
  rm -rf "$HOME/.local/opt/nvim-linux-$nvim_arch"
  curl -fsSL "https://github.com/neovim/neovim/releases/download/$NVIM_VERSION/nvim-linux-$nvim_arch.tar.gz" \
    | tar xz -C "$HOME/.local/opt"
  ln -sf "$HOME/.local/opt/nvim-linux-$nvim_arch/bin/nvim" "$LOCAL_BIN/nvim"
fi

if [[ "$("$LOCAL_BIN/tree-sitter" --version 2>/dev/null)" != "tree-sitter ${TREE_SITTER_VERSION#v}"* ]]; then
  log "Installing tree-sitter CLI $TREE_SITTER_VERSION"
  curl -fsSL "https://github.com/tree-sitter/tree-sitter/releases/download/$TREE_SITTER_VERSION/tree-sitter-linux-$ts_arch.gz" \
    | gunzip >"$LOCAL_BIN/tree-sitter"
  chmod +x "$LOCAL_BIN/tree-sitter"
fi

fonts="$HOME/.local/share/fonts/BlexMonoNerdFont"
if [[ ! -d "$fonts" ]]; then
  log "Installing BlexMono Nerd Font"
  mkdir -p "$fonts"
  curl -fsSL "https://github.com/ryanoasis/nerd-fonts/releases/download/$NERD_FONTS_VERSION/IBMPlexMono.tar.xz" \
    | tar xJ -C "$fonts"
  command -v fc-cache >/dev/null && fc-cache -f "$fonts" >/dev/null
fi
{{ end -}}
